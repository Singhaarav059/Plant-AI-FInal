# Example environment variables for the Plant Disease Detection app

# Vertex AI API key (Express Mode) - used for Gemini plant disease detection & chatbot
# Get yours at: https://aistudio.google.com/app/apikey (generate a Vertex AI key)
GEMINI_API_KEY=your_vertex_ai_api_key_here

# Flask session secret key
SESSION_SECRET=your_session_secret_here

# Database URL (optional, defaults to SQLite)
DATABASE_URL=sqlite:///plantdisease.db
